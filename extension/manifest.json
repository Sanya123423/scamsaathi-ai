{
  "manifest_version": 3,
  "name": "ScamSaathi - AI Cyber Threat & Phishing Detector",
  "version": "1.0.0",
  "description": "Real-time AI-based cyber threat detection for suspicious messages, phishing URLs, and credential harvesting.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_title": "ScamSaathi Cyber Threat Inspector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
